# Dependencies (Crucial to ignore as they are large and easily regenerated)
node_modules/

# Environment variables and secrets (Protects sensitive API keys/passwords)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Build outputs and runtime data
pids
*.pid
*.seed
*.pid.lock
lib-cov
coverage/
.nyc_output
build/
dist/
.next/
.nuxt/
out/

# Caches and tooling
.eslintcache
.npm
.cache/

# Operating System files
.DS_Store
Thumbs.db
